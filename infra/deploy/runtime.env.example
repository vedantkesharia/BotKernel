AWS_REGION=us-east-2
BEDROCK_REGION=
BOTKERNEL_RUNTIME_ENV=aws-demo
BOTKERNEL_API_IMAGE=000000000000.dkr.ecr.us-east-2.amazonaws.com/botkernel-demo-backend:replace-with-immutable-tag
BOTKERNEL_DASHBOARD_IMAGE=000000000000.dkr.ecr.us-east-2.amazonaws.com/botkernel-demo-dashboard:replace-with-immutable-tag
BOTKERNEL_ECR_REGISTRY=000000000000.dkr.ecr.us-east-2.amazonaws.com
BOTKERNEL_LOG_GROUP=/botkernel/demo
BOTKERNEL_DASHBOARD_PORT=8080
BOTKERNEL_DATABASE_URL_FILE=/etc/botkernel/secrets/database_url
BOTKERNEL_POSTGRES_PASSWORD_FILE=/etc/botkernel/secrets/postgres_password
BOTKERNEL_OPERATOR_TOKEN_FILE=/etc/botkernel/secrets/operator_token
BOTKERNEL_AGENT_TOKEN_FILE=/etc/botkernel/secrets/agent_token
BOTKERNEL_METRICS_TOKEN_FILE=/etc/botkernel/secrets/metrics_token
BOTKERNEL_METRICS_TOKEN=
INVESTIGATION_MAX_CONCURRENT=2
INVESTIGATION_EXECUTION_TIMEOUT_SECONDS=30
INVESTIGATION_TERMINATION_GRACE_SECONDS=2
CLOUD_MODE=mock
AWS_DEPLOY_ALLOWED=false
BEDROCK_ENABLED=false
BEDROCK_SPEND_AUTHORIZED=false
BEDROCK_MODEL_ID=
AI_ACTION_EXECUTION_ENABLED=false
AGENT_PROVIDER=deterministic_mock
INVESTIGATOR_PROVIDER=deterministic_mock
BEDROCK_MAX_OUTPUT_TOKENS=512
MAX_BEDROCK_TOKENS_PER_DAY=20000
BEDROCK_MAX_CALLS_PER_RUN=1
BEDROCK_MAX_CALLS_PER_DAY=10
BEDROCK_REQUEST_TIMEOUT_SECONDS=10
AGENT_INTERVAL_SECONDS=8
AGENT_MAX_RUNS=0
BOTKERNEL_OTEL_EXPORTER_OTLP_ENDPOINT=
